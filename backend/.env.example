# Server Configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET=your-secure-secret-key-change-in-production

# Database
MONGODB_URL=mongodb://localhost:27017/universityhub

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email (Gmail SMTP — use an App Password). EMAIL_FROM must be allowed for that account.
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM="University Hub <your-email@gmail.com>"

# Session cookie secure flag (HTTPS/production)
# SESSION_COOKIE_SECURE=true

# Rate limits: window ms (default 900000), max requests per window
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_FORGOT_MAX=5
# RATE_LIMIT_RESEND_MAX=5

# AWS S3 (optional, for file uploads)
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Gemini AI (required for Liqu AI chat and exam question extraction)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key
# GEMINI_MODEL_ID=gemini-2.0-flash